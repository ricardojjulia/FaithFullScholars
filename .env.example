# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:49321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=faithfull-scholars
PORT=3845

# Pilot Feedback & Error Triage Gate
NEXT_PUBLIC_PILOT_FEEDBACK_ENABLED=true

# Rate limiting (ADR 0026). REQUIRED in production (verify:deploy fails without it):
# secret key for the HMAC of the client IP used as the rate-limit key. Use a long random value.
RATE_LIMIT_SALT=
